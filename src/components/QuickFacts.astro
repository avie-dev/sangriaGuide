---
// The "Quick facts" box near the top of an article.
//   <QuickFacts facts={[['Cost', '0.35 Sangricoin per minute'], ['XP per hour', '630,000']]} />
interface Props {
	title?: string;
	facts: [string, string][];
}
const { title = 'Quick facts', facts } = Astro.props;
---

<aside class="sf-facts not-content" aria-label={title}>
	<p class="sf-facts__title">{title}</p>
	<dl>
		{
			facts.map(([k, v]) => (
				<div>
					<dt>{k}</dt>
					<dd>{v}</dd>
				</div>
			))
		}
	</dl>
</aside>

<style>
	.sf-facts {
		margin-block: 1.25rem;
		padding: 0.9rem 1rem;
		border: 1px solid color-mix(in srgb, var(--sf-gold-dim) 60%, transparent);
		border-radius: 0.375rem;
		background: color-mix(in srgb, var(--sl-color-gray-6) 80%, transparent);
	}
	.sf-facts__title {
		margin: 0 0 0.5rem;
		font-family: var(--sf-font-display);
		font-weight: 700;
		color: var(--sf-heading);
	}
	dl {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
		gap: 0.6rem 1rem;
		margin: 0;
	}
	dt {
		font-size: var(--sl-text-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--sl-color-gray-3);
	}
	dd {
		margin: 0.1rem 0 0;
		font-weight: 600;
		color: var(--sl-color-white);
	}
</style>
