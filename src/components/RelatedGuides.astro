---
// "Related guides": pages that build on this one, then pages in the same section sharing a source.
// Only pages that exist are listed. Renders nothing when there are none.
import { plannedPages, isLive } from '../lib/coverage';

const slug = Astro.locals.starlightRoute.id;
const pages = plannedPages();
const me = pages.find((p) => p.slug === slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const related = me
	? [
			...pages.filter((p) => p.needs.includes(slug)),
			...pages.filter((p) => p.section === me.section && p.sources.some((s) => me.sources.includes(s))),
			...me.needs.map((n) => pages.find((p) => p.slug === n)!),
		]
	: [];
const list = [...new Map(related.filter((p) => p && p.slug !== slug && p.slug !== me?.section && isLive(p)).map((p) => [p.slug, p])).values()].slice(0, 6);
---

{
	list.length > 0 && (
		<section aria-labelledby="related-guides">
			<h2 id="related-guides">Related guides</h2>
			<ul>
				{list.map((p) => (
					<li>
						<a href={`${base}/${p.slug}/`}>{p.title}</a>
					</li>
				))}
			</ul>
		</section>
	)
}
