---
// The full player command list from src/data/commands.json (generated by research/commands-data.mjs),
// filterable, with a copy button per command.
//   <CommandTable />              every command
//   <CommandTable source="pets" /> one system's commands
// Descriptions are English where an English guide lists the same command, otherwise the official
// Portuguese text (marked lang="pt"). Command syntax is never translated.
import commands from '../data/commands.json';
import FilterTable from './FilterTable.astro';

interface Props {
	source?: string;
}
const { source } = Astro.props;
const rows = source ? commands.filter((c) => c.source === source) : commands;
if (!rows.length) throw new Error(`CommandTable: no commands for source "${source}"`);
---

<FilterTable placeholder="Filter commands by name, system or description…" label="Filter commands">
	<table class="sf-cmds">
		<thead>
			<tr>
				<th scope="col">Command</th>
				{!source && <th scope="col">System</th>}
				<th scope="col">What it does</th>
			</tr>
		</thead>
		<tbody>
			{
				rows.map((c) => (
					<tr>
						<td class="sf-cmds__cmd">
							<code>{c.cmd}</code>
							<button type="button" class="sf-copy" data-copy={c.cmd} aria-label={`Copy ${c.cmd}`}>
								Copy
							</button>
						</td>
						{!source && <td>{c.system}</td>}
						<td>{'en' in c && c.en ? c.en : <span lang="pt" class="sf-cmds__pt">{c.pt}</span>}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</FilterTable>

<script>
	import { wireCopyButtons } from '../scripts/copy';
	wireCopyButtons();
</script>

<style>
	.sf-cmds {
		font-size: var(--sl-text-sm);
	}
	.sf-cmds__cmd {
		white-space: nowrap;
	}
	.sf-cmds__cmd button {
		margin-inline-start: 0.4rem;
		font-size: var(--sl-text-xs);
		padding: 0.05rem 0.4rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.sf-cmds__pt {
		font-style: italic;
		color: var(--sl-color-gray-2);
	}
</style>
