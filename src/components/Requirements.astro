---
// "Requirements" list: what you need before you can use a system.
//   <Requirements items={['Character level 90', 'Prestige 20']} />
interface Props {
	items: string[];
	title?: string;
}
const { items, title = 'Requirements' } = Astro.props;
---

<section class="sf-req" aria-label={title}>
	<p class="sf-req__title">{title}</p>
	{items.length ? (
		<ul>{items.map((i) => <li>{i}</li>)}</ul>
	) : (
		<p>None.</p>
	)}
</section>

<style>
	.sf-req {
		margin-block: 1rem;
		padding: 0.75rem 1rem;
		border-left: 3px solid var(--sf-crimson);
		background: color-mix(in srgb, var(--sf-crimson-deep) 25%, transparent);
		border-radius: 0 0.375rem 0.375rem 0;
	}
	.sf-req__title {
		margin: 0 0 0.35rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	ul {
		margin: 0;
		padding-left: 1.2rem;
	}
	li::marker {
		content: '✦ ';
		color: var(--sf-gold);
	}
</style>
