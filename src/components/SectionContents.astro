---
// Lists a section's pages, in reading order, with their writing status, from docs/coverage.yaml.
// Pages that don't exist yet are shown without a link, so the overview never points at a 404.
import { plannedPages, sectionTitle, liveHref, type PlannedPage } from '../lib/coverage';

interface Props {
	/** Section directory, e.g. "meditation". Defaults to the current page's section. */
	section?: string;
}
const dir = Astro.props.section ?? Astro.locals.starlightRoute.id.split('/')[0];
if (!sectionTitle(dir)) throw new Error(`SectionContents: no section "${dir}" in docs/coverage.yaml`);
const pages = plannedPages().filter((p) => p.section === dir && p.slug !== dir);
const status = (a: PlannedPage) =>
	a.verified === 'verified' ? 'Verified' : a.writing === 'written' ? 'Written' : a.writing === 'draft' ? 'Draft' : 'Planned';
---

<ol class="sf-contents">
	{
		pages.map((a) => {
			const href = liveHref(a.slug);
			const s = status(a);
			return (
				<li>
					<span class="sf-row">
						{href ? <a href={href}>{a.title}</a> : <span>{a.title}</span>}
						<span class={`sf-status sf-status--${s.toLowerCase()}`}>{s}</span>
					</span>
				</li>
			);
		})
	}
</ol>

<style>
	.sf-row {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
	}
	.sf-status {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		padding: 0 0.4em;
	}
	.sf-status--verified,
	.sf-status--written {
		color: var(--sl-color-white);
		border-color: var(--sf-gold-dim);
	}
</style>
