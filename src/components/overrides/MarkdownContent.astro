---
// Starlight's article body, followed by related guides and the official sources with the
// last-verified date.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import RelatedGuides from '../RelatedGuides.astro';
import Sources from '../Sources.astro';

const data = Astro.locals.starlightRoute.entry.data;
const isArticle = data.template !== 'splash';
const showSources = isArticle && (data.sources.length > 0 || data.status !== 'planned');
---

<Default>
	<slot />
	{isArticle && <RelatedGuides />}
	{showSources && <Sources />}
</Default>
