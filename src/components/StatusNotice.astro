---
// Tells readers how finished a page is, from its `status` frontmatter. Verified pages show nothing.
import { Aside } from '@astrojs/starlight/components';

const status: string = Astro.locals.starlightRoute?.entry?.data?.status ?? 'planned';
const text: Record<string, string> = {
	planned: 'This section is planned but not written yet. Use the official guides linked below in the meantime.',
	draft: 'Draft: parts of this page are incomplete or not yet checked against the official guides.',
	written: 'Checked against the official guides, but not yet confirmed in game. Spotted something wrong? Tell us on the open questions page.',
};
---

{status !== 'verified' && <Aside type="caution" title="Work in progress">{text[status]}</Aside>}
