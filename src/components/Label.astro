---
import { LABEL_INFO, type LabelKey } from '../data/labels';

interface Props {
	type: LabelKey;
}
const { type } = Astro.props;
const info = LABEL_INFO[type];
---

<span class={`sf-label sf-label--${type}`} title={info.meaning}>{info.text}</span>

<style>
	.sf-label {
		display: inline-block;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		line-height: 1.2;
		padding: 0.2em 0.55em;
		border-radius: 0.25rem;
		border: 1px solid currentColor;
		white-space: nowrap;
		vertical-align: middle;
	}
	.sf-label--official { color: #6fcf97; }
	.sf-label--community { color: #8fb8ff; }
	.sf-label--rpg04 { color: var(--sf-gold); }
	.sf-label--verify { color: #ffb454; }
	.sf-label--vip { color: #e58cff; }
	.sf-label--purchase { color: #ff8a8a; }
	:global([data-theme='light']) .sf-label--official { color: #1e7a45; }
	:global([data-theme='light']) .sf-label--community { color: #2457a6; }
	:global([data-theme='light']) .sf-label--verify { color: #9a5a00; }
	:global([data-theme='light']) .sf-label--vip { color: #8a2aa3; }
	:global([data-theme='light']) .sf-label--purchase { color: #a32424; }
</style>
