{
  "name": "sangria-falls-wiki",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial, English-first community wiki and progression guide for the Sangria Falls V Rising server.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/coverage.mjs --check",
    "research": "node research/fetch.mjs && node research/extract.mjs && node research/inventory.mjs && node research/class-data.mjs && node research/commands-data.mjs",
    "coverage": "node scripts/coverage.mjs",
    "check:external": "node scripts/check-external-links.mjs",
    "test": "node --test tests/calc.test.ts",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "starlight-links-validator": "^0.27.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
